GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX_ADDRESS=

# --- Azure AI Vision (OCR for photographed PODs, BOLs and scanned PDFs) ------
# Leave BLANK until the Azure AI Vision resource is provisioned. While blank the pipeline
# resolves to the mock OCR client, and images route to a person with a stated reason rather
# than silently yielding nothing.
#   Endpoint looks like: https://<resource-name>.cognitiveservices.azure.com
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# auto | azure | tesseract | mock.  "auto" uses Azure when the two values above are set,
# falls back to a local Tesseract install if present, otherwise the mock.
PREMIER_OCR_CLIENT=auto
