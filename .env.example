# =============================================================================
# ppm-receiver-automation — configuration template
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored and is the ONLY file the code
# reads for these values.
#
# NEVER commit real values to this file. No keys, no secrets, no live hostnames,
# no tenant or subscription IDs, no project codes. Placeholders only.
# Ashford GitHub Standards v1.5 §9 and §12.
#
# Real values are held in an approved secret store (Azure Key Vault where
# applicable). See docs/data-handling.md for what each value gives access to and
# SECURITY.md for the credential-exposure procedure.
# =============================================================================


# --- Microsoft Graph — the receiving mailbox ---------------------------------
# App-only token for the mailbox the automation reads. Requires Mail.ReadWrite:
# read, because the pipeline reads bodies and attachments; write, because it
# moves each processed message into a filed folder.
# Granted by: Premier / Ashford IT. Renew in the Azure portal under
# App registrations -> <app> -> Certificates & secrets.
# Without these: no ingest at all, and every page is empty.
GRAPH_TENANT_ID=<azure-tenant-guid>
GRAPH_CLIENT_ID=<app-registration-client-id>
GRAPH_CLIENT_SECRET=<client-secret>
GRAPH_MAILBOX_ADDRESS=<receiving-mailbox@example.test>


# --- Azure AI — OCR for photographed and scanned proof of delivery -----------
# Portal -> your Azure AI resource -> Keys and Endpoint. No trailing slash, no quotes.
#   Endpoint looks like: https://<resource-name>.cognitiveservices.azure.com
# Leave BLANK to keep the pipeline on the mock OCR client, where images route to a
# person with a stated reason rather than silently yielding nothing.
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Document Intelligence reuses the pair above unless overridden here. Only set these
# if Document Intelligence lives on a different resource than Vision.
# AZURE_DOC_INTELLIGENCE_ENDPOINT=
# AZURE_DOC_INTELLIGENCE_KEY=

# prebuilt-layout (default) returns table structure; prebuilt-read is text-only and
# ~6x cheaper per page on paid tiers — identical on the free tier, which meters
# pages, not dollars.
# AZURE_DOC_INTELLIGENCE_MODEL=prebuilt-layout

# auto | azure | vision | tesseract | mock.  "azure" is Document Intelligence (the
# production path); "vision" is Image Analysis, which only works on a Vision or
# multi-service resource. "auto" uses Document Intelligence when the values above
# are set, falls back to a local Tesseract install if present, otherwise the mock.
PREMIER_OCR_CLIENT=auto

# How many pages one ingest run may send to OCR before it starts refusing. This is
# the only real spend stop in the pipeline. Raise it if a run reports pages refused;
# lower it to cap a month's spend harder.
# PREMIER_OCR_PAGES_PER_RUN=150

# The largest body this Azure resource will accept. The free (F0) tier caps a request
# at 4 MB and answers anything larger with "InvalidContentLength"; a paid tier allows
# 500 MB. Oversized images are scaled to fit rather than refused.
# PREMIER_OCR_MAX_UPLOAD_BYTES=4194304

# Minimum seconds between OCR submissions. Calls are not concurrent and can still
# overrun the quota, because each analysis costs a POST plus several poll GETs
# against the same allowance. 3s is ~20/min, the free tier's limit. Set 0 on a tier
# that does not need pacing.
# PREMIER_OCR_MIN_CALL_GAP=3


# --- Spitfire sfPMS (ERP) ----------------------------------------------------
# Base URL of the Spitfire instance, with no trailing slash.
#   e.g. https://<spitfire-host>/<instance>
# The API paths are deliberately NOT configurable. They live in the allowlist in the
# Spitfire connector, which rejects any request not on it before a socket opens. That
# allowlist is the guarantee this integration cannot write outside its approved
# surface, and a path swappable from a config file would not be a guarantee.
SPITFIRE_BASE_URL=<https://spitfire-host/instance>

# The Spitfire account every call authenticates as (POST /api/Account). Training and
# Production each have their own login; set the pair for the environment SPITFIRE_BASE_URL
# points at. When set, these win over SPITFIRE_SESSION_COOKIE, the code logs in again by
# itself when the session lapses, and it re-reads this file on each login — so rotating
# the password is an edit here and nothing else. Never commit, log or paste these.
SPITFIRE_UID=
SPITFIRE_PW=

# Development fallback only, used when SPITFIRE_UID/SPITFIRE_PW are blank: the
# `sfPMSAuth` ticket copied from a browser session. It lapses on idle and cannot renew.
# Treat as a credential: never commit, never log, never paste into a prompt.
SPITFIRE_SESSION_COOKIE=

# Pre-shared key pair for the write collection. Not yet issued — pending the Spitfire
# vendor. Leave blank; the write path stays disabled without them.
SPITFIRE_API_CLIENT_ID=
SPITFIRE_API_CLIENT_KEY=

# Client offset from UT, sent on login. Spitfire stamps server-side dates against it,
# so a wrong value shifts received dates by hours and Stage 5 compares those dates to
# POD dates. -5 = US Eastern standard time, -4 during DST.
SPITFIRE_TZ_OFFSET=-5

# Comma-separated project IDs to search when a PO number is not already mirrored.
# The service account cannot enumerate projects, so the list is fixed here. This is a
# real boundary: a PO outside these projects will not resolve, and the UI says so
# rather than claiming the PO does not exist. Add IDs as Premier opens projects up.
SPITFIRE_PROJECT_IDS=<project-id-1>,<project-id-2>

# Document-type GUIDs. These are Spitfire stock constants, identical on every
# installation, and are never fetched at runtime. Defaults live in the Spitfire
# constants module; override here only to point at a non-standard installation.
# SPITFIRE_PO_DOC_TYPE_KEY=
# SPITFIRE_RECEIPT_DOC_TYPE_KEY=
# SPITFIRE_SEARCH_SCOPE=0


# --- Working away from the Spitfire network ----------------------------------
# Spitfire answers only from an allowed network, and the session ticket lapses on
# idle, so the connected window is short. The cassette layer records responses while
# connected and replays them when not. See docs/spitfire-integration.md.
#
#   off     nothing is mounted; the code behaves exactly as in production. THE DEFAULT.
#   record  call live and save every response.
#   replay  never open a socket. Reads and read-backs work; posting is refused,
#           because a replayed create would hand back one key for every delivery.
#   auto    replay on a hit, otherwise live-and-record.
#
# Recorded cassettes contain real vendor names and cost codes. The cassette directory
# is gitignored and must stay that way.
SPITFIRE_CASSETTE_MODE=off
# SPITFIRE_CASSETTE_DIR=state/spitfire_cassettes


# --- Mail routing domains ----------------------------------------------------
# LOAD-BEARING. Triage decides what an email *is* by which of these lists its sender's domain
# falls in. These used to be literals in the settings module, which put Premier's real vendor,
# property and internal domains in source — prohibited by §12. The code now defaults to the
# synthetic `.test` domains the test fixtures use, so the suite runs with no configuration at all;
# every deployed environment must set the real values here.
#
# With these unset in production, live mail routes as if it were test mail: no sender matches any
# list, triage rules stop firing, and nothing looks broken.
#
# Comma-separated, case-insensitive.
PREMIER_INTERNAL_DOMAINS=<the domain mail is forwarded from internally>
PREMIER_WAREHOUSE_SENDER_DOMAINS=<warehouse partner domains>
PREMIER_FREIGHT_SENDER_DOMAINS=fedex.com,ups.com,dhl.com,rxo.com,oldominion.com,globaltranz.com
PREMIER_VENDOR_CONFIRMATION_DOMAINS=<vendor domains that send confirmations>
PREMIER_PROPERTY_DOMAINS=<property/hotel domains>

# Mailboxes that only ever send scheduled reports. Nothing from one is a delivery event, and
# leaving this unset is expensive: one nightly pay-request report lists ~130 PO numbers and was
# enough to stage 126 phantom deliveries in a single arrival.
PREMIER_REPORT_SENDER_ADDRESSES=<address that sends scheduled reports>

# --- Boilerplate anchors -----------------------------------------------------
# Contact fragments that mark the start of a signature or partner footer, so those blocks are
# stripped before extraction reads the message. Real values are Premier's and their partner's
# actual contact details, so they live here rather than in source.
#
# Wrong or unset in production, signature text survives into extraction and an address line reads
# as delivery content. It also breaks Stage 1's property-reply rule, which classifies on a word
# count: a two-word reply measures in the hundreds of words with boilerplate still attached.
PREMIER_BOILERPLATE_INTERNAL_ADDRESS=<street address line in the internal signature>
PREMIER_BOILERPLATE_PARTNER_ADDRESS=<street address line in the partner footer>
PREMIER_BOILERPLATE_PARTNER_PHONE=<phone number in the partner footer>

# --- Pipeline behaviour ------------------------------------------------------
# How long a partially-described delivery is held open for its remaining parts
# before it is swept to a reviewer.
# PREMIER_HOLD_GRACE_HOURS=48

# How far back each ingest run re-reads, to cover clock skew and messages that
# arrived mid-run. Overlap is safe: dedupe is by content fingerprint, not by time.
# PREMIER_INGEST_OVERLAP_MINUTES=10


# --- Local application server ------------------------------------------------
# The review interface. Bind to loopback unless deploying behind a reverse proxy.
# API_HOST=127.0.0.1
# API_PORT=8000

# Comma-separated allowed origins. Leave unset for same-origin only. Do not set to
# "*" in any deployed environment.
# CORS_ORIGINS=

# Name recorded against actions taken from the UI when no signed-in user is present.
# Interim only — replaced when authentication is added. See docs/architecture.md.
# DEFAULT_OPERATOR=
