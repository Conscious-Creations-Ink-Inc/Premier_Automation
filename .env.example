GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX_ADDRESS=

# --- Azure OCR (for photographed PODs, BOLs and scanned PDFs) ----------------
# Portal -> your Azure AI resource -> Keys and Endpoint. No trailing slash, no quotes.
#   Endpoint looks like: https://<resource-name>.cognitiveservices.azure.com
# Leave BLANK to keep the pipeline on the mock OCR client, where images route to a person with
# a stated reason rather than silently yielding nothing.
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Document Intelligence reuses the pair above unless overridden here. Only set these if DocInt
# lives on a different resource than Vision.
# AZURE_DOC_INTELLIGENCE_ENDPOINT=
# AZURE_DOC_INTELLIGENCE_KEY=

# prebuilt-layout (default) returns table structure; prebuilt-read is text-only and ~6x cheaper
# per page on paid tiers — identical on the free tier, which meters pages, not dollars.
# AZURE_DOC_INTELLIGENCE_MODEL=prebuilt-layout

# auto | azure | vision | tesseract | mock.  "azure" is Document Intelligence (the production
# path); "vision" is Image Analysis, which only works on a Vision or multi-service resource.
# "auto" uses Document Intelligence when the values above are set, falls back to a local
# Tesseract install if present, otherwise the mock.
PREMIER_OCR_CLIENT=auto

# --- Spitfire sfPMS (ERP) — READ ONLY ----------------------------------------
# The service account Premier provisions (svc-receiver-automation) needs READ permission only
# for this phase: purchase orders and their lines. It does not need, and should not be granted,
# permission to create documents, attach files or post comments — connectors/spitfire.py has no
# write methods and rejects any non-read request before it opens a socket.
# Leave UID/PW blank until Premier provisions the account; the connector fails with a clear
# message rather than half-working.
SPITFIRE_BASE_URL=https://training.remingtonhotels.com/Training
SPITFIRE_UID=
SPITFIRE_PW=

# Client offset from UT, sent on login. Spitfire stamps server-side dates against it, so a wrong
# value shifts received dates by hours. -5 = US Eastern (standard time), -4 during DST.
SPITFIRE_TZ_OFFSET=-5

# PO document-type key, used to narrow PO discovery. Default comes from Premier's own
# czx_TPICreate_ReceiptDoc.sql and is a PRODUCTION value — confirm it on training before trusting
# it. Discovery still works if it is wrong, just with more candidates to sift.
# SPITFIRE_PO_DOC_TYPE_KEY=ff1975fd-76de-486c-888b-54e8fcd880e0
# SPITFIRE_SEARCH_SCOPE=0
